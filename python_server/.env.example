# Copy this file to .env and set values
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.4
OPENAI_MAX_TOKENS=1200
OPENAI_RETRY_COUNT=2
PORT=8001
# CLIENT_URL can be comma-separated
CLIENT_URL=http://localhost:4200,http://localhost:8001
# When true (1/true/yes) the backend may use the OpenAI API to provide general
# career advice even when no resume or job description is uploaded. Keep false
# by default to avoid unintended model outputs.
ALLOW_GENERAL_LLM=false
